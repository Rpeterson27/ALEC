# ALEC Language Learning Environment Variables

# Google Gemini Configuration (required for LLM calls)
MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ALEC Application Settings  
DEFAULT_TARGET_LANGUAGE=French
DEFAULT_NATIVE_LANGUAGE=English
DEFAULT_LEVEL=beginner
LOG_LEVEL=INFO

# CrewAI Enterprise Configuration (for deployment)
# CREWAI_API_KEY=your_crewai_enterprise_key_here